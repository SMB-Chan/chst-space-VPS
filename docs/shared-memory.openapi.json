  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Clerk session JWT"
      }
    },
    "schemas": {
      "Memory": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "kind": {
            "type": "string",
            "enum": [
              "user_statement",
              "sourced_fact",
              "inference",
              "unverified"
            ],
            "default": "unverified"
          },
          "category": {
            "type": "string",
            "enum": [
              "preference",
              "decision",
              "progress",
              "knowledge"
            ],
            "default": "knowledge"
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "pattern": "^https?://",
            "maxLength": 2000
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200
          },
          "valid_as_of": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
