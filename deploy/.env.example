# Chat-Space VPS deployment environment (deploy/.env)
# Copy to deploy/.env on the VPS and fill in real values. NEVER commit .env.
#
# The app also needs its full runtime configuration; see the repository root
# .env.example for the complete list of application variables (AI providers,
# AUTH_MODE, DATABASE_URL, etc.). All of them belong in this same deploy/.env
# because compose loads it both for variable interpolation and as the app's
# env_file.

# --- Authentication mode ----------------------------------------------------
# AUTH_MODE controls how users sign in. The frontend build mode must match
# (deploy.sh reads this to set VITE_AUTH_MODE when building the app image).
#
# AUTH_MODE=local    — single-operator VPS, no login screen (default)
# AUTH_MODE=clerk    — managed Clerk authentication
# AUTH_MODE=password — built-in multi-user password authentication
#                     (requires BOOTSTRAP_ADMIN_* below on first deploy)
#
# 認証モード。利用者はここで切り替えます。deploy.sh がこの値を読み取り、
# VITE_AUTH_MODE に渡してフロントエンドをビルドします。
AUTH_MODE=local

# --- Password auth (AUTH_MODE=password only) -------------------------------
# Used only when AUTH_MODE=password. After the first deploy succeeds and the
# bootstrap admin can log in, remove BOOTSTRAP_ADMIN_PASSWORD from .env.
# パスワード認証モード専用。初回ログイン後は BOOTSTRAP_ADMIN_PASSWORD を
# .env から削除してください。

# First administrator username. / 初期管理者のユーザー名。
# BOOTSTRAP_ADMIN_USERNAME=admin
# First administrator password. / 初期管理者のパスワード。
# BOOTSTRAP_ADMIN_PASSWORD=change-me-now
# First administrator user id. Leave unset (or set to LOCAL_USER_ID) to
# inherit data tied to the local-mode operator; pick a new uuid to start
# with a clean namespace.
# 初期管理者のユーザーID。未設定、または LOCAL_USER_ID にするとローカル
# モードで使っていたユーザーデータをそのまま引き継ぎます。
# BOOTSTRAP_ADMIN_USER_ID=

# Set to true in production so the session cookie is issued with the Secure
# flag (HTTPS-only). Defaults to true when NODE_ENV=production.
# 本番環境では true にし、HTTPSのみで送信される Secure 属性を Cookie に
# 付与してください。NODE_ENV=production の場合は既定で true。
# AUTH_COOKIE_SECURE=

# --- PostgreSQL ---
DB_PASSWORD=change-me

# --- SearXNG (self-hosted metasearch provider) ---
# Generate a secret:  head -c 24 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9'
SEARXNG_SECRET=change-me
# Internal base URL the app uses to reach the searxng container.
SEARXNG_BASE_URL=http://searxng:8080

# --- OpenCode coding environment (chat-space:code) ---
# Basic auth for the OpenCode web UI behind Tailscale / nginx.
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=
# ask | auto | full
#   ask  — tools need approval
#   auto — auto-approve (autonomous coding; catastrophic bash still denied)
#   full — allow everything
# Overridden by deploy/code-access-mode file when present.
OPENCODE_ACCESS_MODE=auto

# --- Factuality verification tuning (optional) ---
# Set to "off" to always run the verifier even for short, data-free drafts.
# FACTUALITY_RISK_GATE=on
# Override the verifier timeout in milliseconds (default 60000).
# FACTUALITY_TIMEOUT_MS=60000
