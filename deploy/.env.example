# Chat-Space VPS deployment environment (deploy/.env)
# Copy to deploy/.env on the VPS and fill in real values. NEVER commit .env.
#
# The app also needs its full runtime configuration; see the repository root
# .env.example for the complete list of application variables (AI providers,
# AUTH_MODE, DATABASE_URL, etc.). All of them belong in this same deploy/.env
# because compose loads it both for variable interpolation and as the app's
# env_file.

# --- PostgreSQL ---
DB_PASSWORD=change-me

# --- SearXNG (self-hosted metasearch provider) ---
# Generate a secret:  head -c 24 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9'
SEARXNG_SECRET=change-me
# Internal base URL the app uses to reach the searxng container.
SEARXNG_BASE_URL=http://searxng:8080

# --- OpenCode coding environment (chat-space:code) ---
# Basic auth for the OpenCode web UI behind Tailscale / nginx.
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=
# ask | auto | full
#   ask  — tools need approval
#   auto — auto-approve (autonomous coding; catastrophic bash still denied)
#   full — allow everything
# Overridden by deploy/code-access-mode file when present.
OPENCODE_ACCESS_MODE=auto

# --- Factuality verification tuning (optional) ---
# Set to "off" to always run the verifier even for short, data-free drafts.
# FACTUALITY_RISK_GATE=on
# Override the verifier timeout in milliseconds (default 60000).
# FACTUALITY_TIMEOUT_MS=60000
