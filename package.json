{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "check:api-routes": "node scripts/check-openapi-routes.mjs",
    "format:check": "prettier --check \"artifacts/api-server/src/**/*.{ts,tsx}\" \"artifacts/ai-chat-space/src/**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"artifacts/api-server/src/**/*.{ts,tsx}\" \"artifacts/ai-chat-space/src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "postcss>nanoid": "3.3.18",
      "vite>esbuild": "0.28.2"
    }
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
