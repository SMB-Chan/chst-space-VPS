modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.shared]
DASHSCOPE_BASE_URL = "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"
ADMIN_CLERK_USER_IDS = "user_3I4PXO7vXEuNKPuJkdddXZ75MCB"

[userenv.production]
FRONTEND_URL = "https://chat-smb.replit.app"
ADMIN_CLERK_USER_IDS = "user_3I4PXO7vXEuNKPuJkdddXZ75MCB"

[nix]
channel = "stable-25_05"
packages = ["libreoffice", "ipaexfont", "chromium", "codex"]
