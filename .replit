modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.shared]
DISABLE_OPENAI_MODELS = "true"
DISABLE_DASHSCOPE_MODELS = "true"
DASHSCOPE_BASE_URL = "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"
ADMIN_CLERK_USER_IDS = "user_3I4PXO7vXEuNKPuJkdddXZ75MCB"
SEARCH_INITIAL_FANOUT = "2"

[userenv.production]
FRONTEND_URL = "https://chat-smb.replit.app"
ADMIN_CLERK_USER_IDS = "user_3I4PXO7vXEuNKPuJkdddXZ75MCB"
SEARCH_INITIAL_FANOUT = "2"

[nix]
channel = "stable-25_05"
# ffmpeg/ffprobe are runtime dependencies of the audio pipeline, not a
# convenience: MiMo ASR accepts only wav and mp3 so other containers are
# transcoded, and ffprobe measures duration before the upload limits apply.
# Declared explicitly rather than relying on chromium/libreoffice pulling it in.
packages = ["libreoffice", "ipaexfont", "chromium", "codex", "ffmpeg"]
