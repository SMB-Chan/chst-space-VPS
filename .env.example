# =============================================================================
# Chat-Space / AI Chat Space — environment template
# Copy to .env (or set in Replit Secrets) and fill in values.
# Never commit a real .env file.
# =============================================================================

# --- Required: database ------------------------------------------------------
# Postgres connection string used by Drizzle (@workspace/db)
DATABASE_URL=postgres://user:password@localhost:5432/chat_space

# --- Required: API server ----------------------------------------------------
# Local default is 5000 if unset. Replit sets this automatically.
PORT=5000
# Health routes are intentionally unauthenticated for deployment probes. Keep
# aggregate AI/browser counters private unless an operator explicitly opts in.
# HEALTH_INCLUDE_OPERATIONAL_METRICS=0

# --- Required: frontend (Vite) ----------------------------------------------
# Local defaults: PORT=5173, BASE_PATH=/
# On Replit these are injected. For local `pnpm --filter @workspace/ai-chat-space run dev`:
#   PORT=5173 BASE_PATH=/ pnpm --filter @workspace/ai-chat-space run dev
# BASE_PATH=/
# Optional: proxy /api to the API server during Vite dev
# API_PROXY_TARGET=http://127.0.0.1:5000
# Browser origin allowlist for the API (comma-separated). Required for
# cross-origin production deployments; local development is permissive when unset.
FRONTEND_URL=http://localhost:5173

# --- Required: Clerk auth ----------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Production only. If the browser must proxy Clerk's Frontend API through this
# app, configure the browser URL as a canonical absolute HTTPS endpoint.
# The server derives a request-specific HTTPS proxy URL only after Host matches
# CLERK_ALLOWED_HOSTS, REPLIT_DOMAINS, FRONTEND_URL, or the optional canonical
# CLERK_PROXY_URL below. Arbitrary forwarded hosts/protocols are never trusted.
# CLERK_PROXY_URL=https://app.example.com/api/__clerk
# VITE_CLERK_PROXY_URL=https://app.example.com/api/__clerk
# Optional comma-separated public hostnames allowed to select a dynamic Clerk
# production publishable key and expose /api/__clerk. Replit-provided
# REPLIT_DOMAINS and FRONTEND_URL hostnames are also added automatically.
# CLERK_ALLOWED_HOSTS=app.example.com,alternate.example.com

# --- Required: OpenAI (Replit AI Integrations proxy, or your own) ------------
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-xxxxxxxx

# --- Optional: DashScope / Alibaba Model Studio (Qwen, DeepSeek, GLM) --------
DASHSCOPE_API_KEY=
# Token Plan chat endpoints are kept separate from server-side media tools.
# Review Alibaba's current Token Plan usage policy before using a plan key in
# any custom application. The specialist transports below deliberately reject
# Token Plan keys and require a regular Model Studio API credential.
# Example Singapore Token Plan endpoint used by compatible coding/agent tools:
# DASHSCOPE_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Optional: Token Plan quota guard ---------------------------------------
# For Personal Token Plan (`sk-sp-...`) chat traffic, Chat-Space can query the
# provider's 5-hour / 1-week quota percentages before each request (30s cache)
# and stop only requests classified as high-cost when remaining headroom is
# below the configured floor. Normal short requests are warned but not blocked.
#
# Alibaba's quota query is a CONSOLE-domain API and does not accept the Token
# Plan API key itself. Obtain a console access token with the official Model
# Studio CLI (`bl auth login --console`) and store the access token as a Replit
# Secret. It can expire; when unavailable, the guard fails open and logs that
# authoritative quota telemetry could not be checked.
# ALIBABA_CONSOLE_ACCESS_TOKEN=
# ALIBABA_TOKEN_PLAN_QUOTA_GUARD=1
# Warn in server logs when the limiting active window falls to this percentage.
# ALIBABA_TOKEN_PLAN_WARN_REMAINING_PERCENT=25
# Block HIGH-COST individual Token Plan chat calls below this percentage.
# ALIBABA_TOKEN_PLAN_BLOCK_HEAVY_REMAINING_PERCENT=10
# Large multi-step turns are checked earlier, before web/vision/audit/file work.
# Examples: long high-reasoning context, multiple images/attachments, explicit
# PDF/Office generation, or answer + Alibaba audit in one turn. The earlier
# reserve is intentionally larger than the individual-call emergency floor.
# ALIBABA_TOKEN_PLAN_WARN_LARGE_TURN_REMAINING_PERCENT=35
# ALIBABA_TOKEN_PLAN_BLOCK_LARGE_TURN_REMAINING_PERCENT=20
# Provider quota request timeout/cache controls.
# ALIBABA_TOKEN_PLAN_QUOTA_TIMEOUT_MS=3000
# ALIBABA_TOKEN_PLAN_QUOTA_CACHE_MS=30000
#
# --- Optional: Alibaba server-side specialist media APIs ---------------------
# Use a REGULAR Model Studio API credential intended for application-backend
# API calls. Do not place a Token Plan key here. If omitted, image generation,
# image editing, and Qwen Audio TTS stay visible in the capability catalog but
# are not offered as executable tools.
# ALIBABA_SPECIALIST_API_KEY=
# Recommended: set your Singapore Model Studio workspace ID. It is used for
# the workspace-specific Qwen Audio TTS WebSocket endpoint and request header.
# ALIBABA_SPECIALIST_WORKSPACE_ID=
# Optional HTTPS Model Studio API base for specialist HTTP transports:
# ALIBABA_SPECIALIST_HTTP_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1/
# Qwen Audio 3.0 ASR Flash uses the synchronous multimodal-generation endpoint,
# Base64 data URLs, and a maximum five-minute audio clip. The workspace ID
# selects the Singapore Model Studio endpoint when the HTTP base is omitted.
# Optional WSS endpoint for Qwen Audio TTS/CosyVoice:
# ALIBABA_SPECIALIST_TTS_WS_URL=wss://<workspace-id>.ap-southeast-1.maas.aliyuncs.com/api-ws/v1/inference
# Optional WSS endpoint for Qwen Audio Realtime Plus (PTT voice mode):
# ALIBABA_SPECIALIST_REALTIME_WS_URL=wss://<workspace-id>.ap-southeast-1.maas.aliyuncs.com/api-ws/v1/realtime?model=qwen-audio-3.0-realtime-plus

# --- Optional: AI endpoint abuse controls -----------------------------------
# Per-user limits are authoritative in PostgreSQL and therefore shared across
# independent Autoscale API instances. Set either limit to 0 to disable it.
AI_REQUESTS_PER_MINUTE=20
AI_MAX_CONCURRENT_REQUESTS=2
# Concurrency is represented by an expiring lease and renewed while the SSE
# request is alive. This bounds stale capacity after a process crash.
AI_CONCURRENCY_LEASE_TTL_MS=90000

# --- Optional: vision bridge -------------------------------------------------
# When the answering/auditing model cannot see images (DeepSeek, GLM), this
# vision-capable model transcribes attached images to text first.
# Defaults to qwen3.6-flash (DashScope configured) or gpt-5.6-luna otherwise.
# VISION_BRIDGE_MODEL=qwen3.6-flash

# --- Optional: audio attachment transcription -------------------------------
# Model for audio attachments (mp3/wav/m4a/ogg/flac/webm). Defaults to
# gpt-4o-mini-transcribe with automatic fallback to whisper-1. A regular
# DashScope configuration may also provide the Qwen ASR and Paraformer fallback.
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Optional: web search APIs ----------------------------------------------
# When any of these keys is set, the keyed search API is used instead of
# DuckDuckGo HTML scraping (which stays as the keyless fallback).
# Preference order when multiple are set: Tavily > Exa > Brave.
# TAVILY_API_KEY=tvly-xxxxxxxx
# EXA_API_KEY=xxxxxxxx
# BRAVE_SEARCH_API_KEY=xxxxxxxx

# --- Optional: web page fetch fallback --------------------------------------
# Fallback chain for URLs whose body cannot be read from raw HTML
# (JS-rendered pages, bot-protection interstitials):
# 1. Local headless Chromium (Playwright). Private; ON by default.
#    The server prefers PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH, then Chromium on
#    PATH (Replit provisions this through Nix), then a Playwright-managed
#    browser installation when available.
#    Set to 0 to disable (e.g. on hosts without any usable Chromium).
#    All browser-generated requests pass the same SSRF guard as plain HTTP.
#    PLAYWRIGHT_MAX_CONCURRENCY caps simultaneous page loads (default 1;
#    raise only after load testing).
# WEB_FETCH_PLAYWRIGHT_FALLBACK=1
# PLAYWRIGHT_MAX_CONCURRENCY=1
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/path/to/chromium
# 2. Re-fetch through the r.jina.ai rendering proxy. OFF by default because
#    the target URL is sent to a third-party service. Set to 1 to enable.
#    JINA_API_KEY lifts the anonymous rate limit (~20 rpm; free tier exists).
# WEB_FETCH_RENDER_FALLBACK=0
# JINA_API_KEY=
