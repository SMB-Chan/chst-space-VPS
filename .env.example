# =============================================================================
# Chat-Space / AI Chat Space — environment template
# Copy to .env (or set in Replit Secrets) and fill in values.
# Never commit a real .env file.
# =============================================================================

# --- Required: database ------------------------------------------------------
# Postgres connection string used by Drizzle (@workspace/db)
DATABASE_URL=postgres://user:password@localhost:5432/chat_space

# --- Required: API server ----------------------------------------------------
# Local default is 5000 if unset. Replit sets this automatically.
PORT=5000

# --- Required: frontend (Vite) ----------------------------------------------
# Local defaults: PORT=5173, BASE_PATH=/
# On Replit these are injected. For local `pnpm --filter @workspace/ai-chat-space run dev`:
#   PORT=5173 BASE_PATH=/ pnpm --filter @workspace/ai-chat-space run dev
# BASE_PATH=/
# Optional: proxy /api to the API server during Vite dev
# API_PROXY_TARGET=http://127.0.0.1:5000
# Browser origin allowlist for the API (comma-separated). Required for
# cross-origin production deployments; local development is permissive when unset.
FRONTEND_URL=http://localhost:5173

# --- Required: Clerk auth ----------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Production only — empty in local/dev so Clerk talks to its own frontend API
# VITE_CLERK_PROXY_URL=

# --- Required: OpenAI (Replit AI Integrations proxy, or your own) ------------
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-xxxxxxxx

# --- Optional: DashScope / Alibaba Model Studio (Qwen, DeepSeek, GLM) --------
DASHSCOPE_API_KEY=
# Token Plan must use the region-specific endpoint, not the generic intl URL.
# Example (Singapore Token Plan):
# DASHSCOPE_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Optional: AI endpoint abuse controls -----------------------------------
# Per-user, per-process limits. Set either to 0 to disable that limit.
AI_REQUESTS_PER_MINUTE=20
AI_MAX_CONCURRENT_REQUESTS=2

# --- Optional: vision bridge -------------------------------------------------
# When the answering/auditing model cannot see images (DeepSeek, GLM), this
# vision-capable model transcribes attached images to text first.
# Defaults to qwen3.6-flash (DashScope configured) or gpt-5.6-luna otherwise.
# VISION_BRIDGE_MODEL=qwen3.6-flash

# --- Optional: web search APIs ----------------------------------------------
# When any of these keys is set, the keyed search API is used instead of
# DuckDuckGo HTML scraping (which stays as the keyless fallback).
# Preference order when multiple are set: Tavily > Exa > Brave.
# TAVILY_API_KEY=tvly-xxxxxxxx
# EXA_API_KEY=xxxxxxxx
# BRAVE_SEARCH_API_KEY=xxxxxxxx

# --- Optional: web page fetch fallback --------------------------------------
# Fallback chain for URLs whose body cannot be read from raw HTML
# (JS-rendered pages, bot-protection interstitials):
# 1. Local headless Chromium (Playwright). Private; ON by default.
#    Requires: pnpm --filter @workspace/api-server exec playwright install chromium
#    Set to 0 to disable (e.g. on hosts without the browser installed).
#    All browser-generated requests pass the same SSRF guard as plain HTTP.
#    PLAYWRIGHT_MAX_CONCURRENCY caps simultaneous page loads (default 1;
#    raise only after load testing).
# WEB_FETCH_PLAYWRIGHT_FALLBACK=1
# PLAYWRIGHT_MAX_CONCURRENCY=1
# 2. Re-fetch through the r.jina.ai rendering proxy. OFF by default because
#    the target URL is sent to a third-party service. Set to 1 to enable.
#    JINA_API_KEY lifts the anonymous rate limit (~20 rpm; free tier exists).
# WEB_FETCH_RENDER_FALLBACK=0
# JINA_API_KEY=
